{
  "name": "paperweave",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "release:build:macos": "tauri build --bundles app,dmg --no-sign",
    "release:verify:macos": "bash scripts/verify-macos-release.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "lucide-react": "0.468.0",
    "pdfjs-dist": "5.6.205",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.9.0"
}
