{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperWeave",
  "version": "0.1.0",
  "identifier": "app.paperweave.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PaperWeave / 论织",
        "width": 1440,
        "height": 1000,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns"],
    "category": "Education",
    "shortDescription": "Evidence-led research workspace",
    "longDescription": "A local-first desktop workspace for deep paper reading, evidence anchors, human-reviewed claims, and durable research notes.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
