{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperweave.local/schemas/reading-guide.schema.json",
  "title": "PaperWeave Reading Guide Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_status", "scope_label", "why_read", "research_question", "prerequisites", "reading_path", "verification_questions", "likely_key_artifacts", "caveats"],
  "properties": {
    "schema_version": { "const": 1 },
    "review_status": { "const": "draft" },
    "scope_label": { "type": "string", "enum": ["abstract_only", "partial_text", "full_text"] },
    "why_read": { "$ref": "#/$defs/groundedText" },
    "research_question": { "$ref": "#/$defs/groundedText" },
    "prerequisites": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/prerequisite" } },
    "reading_path": { "type": "array", "minItems": 3, "maxItems": 7, "items": { "$ref": "#/$defs/pathItem" } },
    "verification_questions": { "type": "array", "minItems": 3, "maxItems": 7, "items": { "$ref": "#/$defs/question" } },
    "likely_key_artifacts": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/artifact" } },
    "caveats": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 500 } }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "anchors": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
    "groundedText": {
      "type": "object", "additionalProperties": false, "required": ["text", "anchor_ids"],
      "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 1500 }, "anchor_ids": { "$ref": "#/$defs/anchors" } }
    },
    "prerequisite": {
      "type": "object", "additionalProperties": false, "required": ["concept", "why_needed", "anchor_ids"],
      "properties": { "concept": { "type": "string", "maxLength": 200 }, "why_needed": { "type": "string", "maxLength": 800 }, "anchor_ids": { "$ref": "#/$defs/anchors" } }
    },
    "pathItem": {
      "type": "object", "additionalProperties": false, "required": ["order", "target", "purpose", "anchor_ids"],
      "properties": { "order": { "type": "integer", "minimum": 1, "maximum": 7 }, "target": { "type": "string", "maxLength": 200 }, "purpose": { "type": "string", "maxLength": 800 }, "anchor_ids": { "$ref": "#/$defs/anchors" } }
    },
    "question": {
      "type": "object", "additionalProperties": false, "required": ["question", "reason", "candidate_anchor_ids"],
      "properties": { "question": { "type": "string", "maxLength": 500 }, "reason": { "type": "string", "maxLength": 800 }, "candidate_anchor_ids": { "$ref": "#/$defs/anchors" } }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["label", "expected_value", "anchor_ids", "confidence"],
      "properties": { "label": { "type": "string", "maxLength": 200 }, "expected_value": { "type": "string", "maxLength": 800 }, "anchor_ids": { "$ref": "#/$defs/anchors" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } }
    }
  }
}
